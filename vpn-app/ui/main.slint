import { Button, LineEdit, VerticalBox, HorizontalBox, GroupBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "VPN Demo";
    preferred-width: 380px;
    preferred-height: 360px;

    in-out property <string> socks5-address: "192.168.31.209:1080";
    in-out property <bool> connected: false;
    in-out property <string> status-text: "Disconnected";
    in-out property <string> log-text: "";

    callback connect-clicked(string);
    callback disconnect-clicked();
    callback test-clicked(string);

    VerticalBox {
        alignment: center;
        padding: 20px;
        spacing: 16px;

        Text {
            text: "VPN Demo";
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        GroupBox {
            title: "SOCKS5 Proxy Server";
            VerticalBox {
                padding: 8px;
                spacing: 8px;
                LineEdit {
                    placeholder-text: "ip:port (e.g. 1.2.3.4:1080)";
                    text <=> socks5-address;
                    enabled: !connected;
                }
            }
        }

        HorizontalBox {
            alignment: center;
            spacing: 8px;
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: connected ? #4caf50 : #f44336;
            }
            Text {
                text: status-text;
                font-size: 14px;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            alignment: center;
            spacing: 12px;

            Button {
                text: connected ? "Disconnect" : "Connect VPN";
                primary: !connected;
                clicked => {
                    if (connected) {
                        disconnect-clicked();
                    } else {
                        connect-clicked(socks5-address);
                    }
                }
            }

            Button {
                text: "Test SOCKS5";
                clicked => {
                    test-clicked(socks5-address);
                }
            }
        }

        Text {
            text: log-text;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
